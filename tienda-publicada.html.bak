<title>Tropical Store — Ivirgarzama</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root{
    --bg:#f5f7f1; --surface:#ffffff; --surface-2:#eaf3ec;
    --ink:#0f2119; --ink-soft:#566b60; --line:#e4e9dd;
    --green:#0ea06a; --green-deep:#0a7d54; --amber:#ff9a3d; --amber-soft:#ffc06b;
    --teal:#12b3a6; --coral:#ff6f61;
    --grad-brand:linear-gradient(135deg,#17c07f,#0a7d54);
    --grad-sun:linear-gradient(135deg,#ffbf5c,#ff7a59);
    --grad-hero:linear-gradient(155deg,#0a7d54 0%,#0ea06a 45%,#14b3a6 100%);
    --shadow:0 8px 28px rgba(16,60,40,.10);
    --shadow-hover:0 18px 42px rgba(16,60,40,.17);
    --radius:16px; --radius-lg:24px;
    --f-display:"Trebuchet MS","Segoe UI",system-ui,sans-serif;
    --f-body:"Segoe UI",system-ui,-apple-system,sans-serif;
  }
  @media (prefers-color-scheme:dark){
    :root{ --bg:#0a140f; --surface:#11201a; --surface-2:#183026;
      --ink:#eaf5ee; --ink-soft:#9fb6a8; --line:#223a2e;
      --green:#2fd08f; --green-deep:#18a870; --amber:#ffb056; --amber-soft:#ff8f3d;
      --teal:#2bd0c2; --coral:#ff8378;
      --grad-brand:linear-gradient(135deg,#2fd08f,#12946a);
      --grad-sun:linear-gradient(135deg,#ffb056,#ff7a59);
      --grad-hero:linear-gradient(155deg,#093a29 0%,#0f6b4a 50%,#12817a 100%);
      --shadow:0 8px 28px rgba(0,0,0,.45); --shadow-hover:0 18px 42px rgba(0,0,0,.55); }
  }
  :root[data-theme="dark"]{ --bg:#0a140f; --surface:#11201a; --surface-2:#183026;
    --ink:#eaf5ee; --ink-soft:#9fb6a8; --line:#223a2e;
    --green:#2fd08f; --green-deep:#18a870; --amber:#ffb056; --amber-soft:#ff8f3d;
    --teal:#2bd0c2; --coral:#ff8378;
    --grad-brand:linear-gradient(135deg,#2fd08f,#12946a);
    --grad-sun:linear-gradient(135deg,#ffb056,#ff7a59);
    --grad-hero:linear-gradient(155deg,#093a29 0%,#0f6b4a 50%,#12817a 100%);
    --shadow:0 8px 28px rgba(0,0,0,.45); --shadow-hover:0 18px 42px rgba(0,0,0,.55); }
  :root[data-theme="light"]{ --bg:#f5f7f1; --surface:#ffffff; --surface-2:#eaf3ec;
    --ink:#0f2119; --ink-soft:#566b60; --line:#e4e9dd;
    --green:#0ea06a; --green-deep:#0a7d54; --amber:#ff9a3d; --amber-soft:#ffc06b;
    --teal:#12b3a6; --coral:#ff6f61;
    --grad-brand:linear-gradient(135deg,#17c07f,#0a7d54);
    --grad-sun:linear-gradient(135deg,#ffbf5c,#ff7a59);
    --grad-hero:linear-gradient(155deg,#0a7d54 0%,#0ea06a 45%,#14b3a6 100%);
    --shadow:0 8px 28px rgba(16,60,40,.10); --shadow-hover:0 18px 42px rgba(16,60,40,.17); }

  *{box-sizing:border-box}
  body{margin:0;color:var(--ink);font-family:var(--f-body);line-height:1.5;
    background:
      radial-gradient(1100px 560px at 100% -8%, color-mix(in srgb,var(--teal) 16%,transparent), transparent 60%),
      radial-gradient(900px 520px at -8% 2%, color-mix(in srgb,var(--green) 13%,transparent), transparent 55%),
      var(--bg);
    background-attachment:fixed}
  a{color:inherit}
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px}

  /* Header */
  header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);
    backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;gap:18px;padding:14px 0}
  .brand{display:flex;align-items:center;gap:10px;font-family:var(--f-display);font-weight:800;
    font-size:1.25rem;letter-spacing:-.02em}
  .brand .leaf{width:36px;height:36px;border-radius:12px;background:var(--grad-brand);
    display:grid;place-items:center;color:#fff;font-size:1.15rem;box-shadow:0 4px 12px color-mix(in srgb,var(--green) 45%,transparent)}
  .brand small{display:block;font-size:.62rem;font-weight:600;color:var(--ink-soft);letter-spacing:.14em;text-transform:uppercase}
  .spacer{flex:1}
  .search{flex:1;max-width:340px;display:flex;align-items:center;gap:8px;background:var(--surface);
    border:1px solid var(--line);border-radius:999px;padding:8px 14px}
  .search input{border:0;background:transparent;outline:none;color:var(--ink);width:100%;font-size:.9rem}
  .icon-btn{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:999px;
    padding:9px 14px;cursor:pointer;color:var(--ink);font-weight:700;font-size:.9rem;display:flex;gap:7px;align-items:center}
  .badge{position:absolute;top:-6px;right:-6px;background:var(--amber);color:#1b1205;font-size:.68rem;
    font-weight:800;min-width:19px;height:19px;border-radius:999px;display:grid;place-items:center;padding:0 5px}
  .theme{background:transparent;border:1px solid var(--line);border-radius:999px;width:40px;height:40px;cursor:pointer;font-size:1.1rem}

  /* Hero */
  .hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
  .hero::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(560px 300px at 88% 8%, color-mix(in srgb,var(--teal) 18%,transparent), transparent 62%)}
  .hero-inner{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center;padding:60px 0}
  .hero h1{font-family:var(--f-display);font-size:clamp(2.1rem,5vw,3.4rem);line-height:1.02;
    letter-spacing:-.03em;margin:0 0 14px;text-wrap:balance}
  .hero h1 em{color:var(--green);font-style:normal}
  .hero p{font-size:1.08rem;color:var(--ink-soft);max-width:46ch;margin:0 0 22px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .btn{border:0;cursor:pointer;font-weight:700;font-size:.95rem;padding:14px 24px;border-radius:999px;font-family:var(--f-body);transition:.18s}
  .btn-primary{background:var(--grad-brand);color:#fff;box-shadow:0 8px 20px color-mix(in srgb,var(--green) 40%,transparent)}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 26px color-mix(in srgb,var(--green) 48%,transparent)}
  .btn-ghost{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
  .btn-ghost:hover{border-color:var(--green)}
  .hero-card{background:var(--grad-hero);border-radius:var(--radius-lg);
    padding:32px;color:#eafff3;box-shadow:var(--shadow-hover);position:relative;overflow:hidden}
  .hero-card::after{content:"🌴";position:absolute;right:-8px;bottom:-14px;font-size:7rem;opacity:.14;transform:rotate(-12deg)}
  .hero-card h3{margin:0 0 6px;font-family:var(--f-display);font-size:1.4rem}
  .hero-stats{display:flex;gap:22px;margin-top:22px}
  .hero-stats div{flex:1}
  .hero-stats b{display:block;font-size:1.7rem;font-family:var(--f-display)}
  .hero-stats span{font-size:.78rem;opacity:.85}
  .pill{display:inline-block;background:rgba(255,255,255,.16);padding:5px 12px;border-radius:999px;
    font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}

  /* Categories */
  .cats{display:flex;gap:10px;flex-wrap:wrap;padding:30px 0 8px}
  .chip{border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
    padding:10px 18px;border-radius:999px;cursor:pointer;font-weight:600;font-size:.88rem;transition:.16s}
  .chip:hover{border-color:var(--green);color:var(--ink)}
  .chip.active{background:var(--grad-brand);color:#fff;border-color:transparent;
    box-shadow:0 6px 16px color-mix(in srgb,var(--green) 34%,transparent)}

  /* Grid */
  .section-head{display:flex;align-items:baseline;justify-content:space-between;padding:16px 0 2px}
  .section-head h2{font-family:var(--f-display);font-size:1.6rem;margin:0;letter-spacing:-.02em}
  .section-head span{color:var(--ink-soft);font-size:.9rem;font-weight:600}
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:22px 0 72px}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);
    overflow:hidden;display:flex;flex-direction:column;transition:.2s;box-shadow:var(--shadow)}
  .card:hover{transform:translateY(-5px);box-shadow:var(--shadow-hover);
    border-color:color-mix(in srgb,var(--green) 38%,var(--line))}
  .thumb{aspect-ratio:1/1;position:relative;overflow:hidden;background:var(--surface-2)}
  .thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:.35s}
  .card:hover .thumb img{transform:scale(1.05)}
  .tag{position:absolute;top:12px;left:12px;background:var(--grad-sun);color:#3a1c00;font-size:.68rem;
    font-weight:800;padding:5px 11px;border-radius:999px;text-transform:uppercase;letter-spacing:.04em;
    box-shadow:0 4px 12px rgba(0,0,0,.18)}
  .card-body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
  .card .cat-label{font-size:.66rem;font-weight:800;color:var(--green);text-transform:uppercase;letter-spacing:.1em}
  .card h3{margin:0;font-size:1.02rem;line-height:1.3;font-family:var(--f-display);font-weight:700}
  .card .desc{font-size:.82rem;color:var(--ink-soft);flex:1;line-height:1.45}
  .price-row{display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:10px}
  .price{font-family:var(--f-display);font-weight:800;font-size:1.22rem;white-space:nowrap;color:var(--green-deep)}
  .price small{font-size:.72rem;color:var(--ink-soft);font-weight:600}
  .add{background:var(--grad-brand);color:#fff;border:0;border-radius:12px;padding:10px 14px;cursor:pointer;
    font-weight:700;font-size:.82rem;white-space:nowrap;transition:.16s}
  .add:hover{filter:brightness(1.06)}
  .add:active{transform:scale(.95)}

  /* Cart drawer */
  .overlay{position:fixed;inset:0;background:rgba(10,20,14,.5);opacity:0;pointer-events:none;transition:.2s;z-index:80}
  .overlay.open{opacity:1;pointer-events:auto}
  .drawer{position:fixed;top:0;right:0;height:100%;width:min(400px,92vw);background:var(--bg);
    z-index:90;transform:translateX(100%);transition:.25s;display:flex;flex-direction:column;border-left:1px solid var(--line)}
  .drawer.open{transform:translateX(0)}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:20px;border-bottom:1px solid var(--line)}
  .drawer-head h3{margin:0;font-family:var(--f-display)}
  .close{background:transparent;border:0;font-size:1.5rem;cursor:pointer;color:var(--ink)}
  .cart-items{flex:1;overflow-y:auto;padding:12px 20px}
  .ci{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
  .ci .em{width:46px;height:46px;background:var(--surface-2);border-radius:10px;display:grid;place-items:center;font-size:1.5rem}
  .ci-info{flex:1}
  .ci-info b{font-size:.9rem;display:block}
  .ci-info span{font-size:.8rem;color:var(--ink-soft)}
  .qty{display:flex;align-items:center;gap:8px}
  .qty button{width:26px;height:26px;border-radius:8px;border:1px solid var(--line);background:var(--surface);
    cursor:pointer;font-weight:800;color:var(--ink)}
  .empty{text-align:center;color:var(--ink-soft);padding:50px 20px}
  .drawer-foot{padding:20px;border-top:1px solid var(--line);background:var(--surface)}
  .total-row{display:flex;justify-content:space-between;font-family:var(--f-display);font-size:1.25rem;font-weight:800;margin-bottom:14px}
  .wa{width:100%;text-align:center;background:#25d366;color:#062b14;text-decoration:none;
    display:block;padding:14px;border-radius:12px;font-weight:800}

  footer{border-top:1px solid var(--line);background:var(--surface);padding:36px 0;color:var(--ink-soft);font-size:.9rem}
  .foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:24px}
  .foot-grid h4{color:var(--ink);font-family:var(--f-display);margin:0 0 10px}

  /* Mobile-only components (hidden on desktop) */
  .msearch{display:none}
  .cartbar{display:none}

  @media(max-width:920px){
    .hero-inner{grid-template-columns:1fr;padding:30px 0;gap:20px}
    .hero-cta{gap:10px}
    .hero-cta .btn{flex:1 1 auto;text-align:center}
    .grid{grid-template-columns:repeat(2,1fr)}
    .search{display:none}
    .foot-grid{grid-template-columns:1fr}
    /* full-width search under the header */
    .msearch{display:flex;align-items:center;gap:9px;position:sticky;top:63px;z-index:45;
      margin:10px auto 0;max-width:1180px;width:calc(100% - 32px);
      background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:12px 16px;box-shadow:var(--shadow)}
    .msearch input{border:0;background:transparent;outline:none;color:var(--ink);width:100%;font-size:1rem}
    /* sticky bottom cart bar */
    .cartbar.show{display:flex;position:fixed;left:12px;right:12px;bottom:12px;z-index:70;
      align-items:center;justify-content:space-between;gap:10px;
      background:var(--green);color:#fff;border:0;border-radius:14px;padding:15px 18px;
      font-weight:800;font-size:.95rem;box-shadow:0 10px 26px rgba(0,0,0,.4);cursor:pointer}
    .cartbar .cta{opacity:.92;font-weight:700}
    main{padding-bottom:96px}
  }
  @media(max-width:520px){
    .wrap{padding:0 14px}
    .grid{grid-template-columns:repeat(2,1fr);gap:12px}
    .brand small{display:none}
    /* swipeable category chips */
    .cats{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:16px 0 4px}
    .cats::-webkit-scrollbar{display:none}
    .chip{flex:0 0 auto}
    .section-head h2{font-size:1.3rem}
    .card h3{font-size:.95rem}
    .card .desc{font-size:.8rem}
    .price-row{flex-wrap:wrap}
    .add{padding:10px 13px;font-size:.85rem}
    .hero h1{font-size:clamp(1.9rem,8vw,2.4rem)}
    .hero-card{padding:22px}
  }
</style>

<header>
  <div class="wrap bar">
    <div class="brand">
      <span class="leaf">🌴</span>
      <span>Tropi<span style="color:var(--green)">Market</span><small>Ivirgarzama · Chapare</small></span>
    </div>
    <div class="search">
      <span>🔍</span><input id="search" placeholder="Buscar productos…" oninput="render()">
    </div>
    <div class="spacer"></div>
    <button class="theme" onclick="toggleTheme()" title="Tema" id="themeBtn">🌙</button>
    <button class="icon-btn" onclick="openCart()">🛒 Carrito<span class="badge" id="badge">0</span></button>
  </div>
</header>

<div class="msearch">
  <span>🔍</span>
  <input id="searchM" placeholder="Buscar productos…" oninput="syncSearch(this.value)" aria-label="Buscar productos">
</div>

<section class="hero">
  <div class="wrap hero-inner">
    <div>
      <span class="pill" style="background:var(--surface-2);color:var(--green)">Envíos a todo el trópico</span>
      <h1 style="margin-top:14px">Todo lo que tu hogar necesita, <em>aquí en Ivirgarzama</em>.</h1>
      <p>Desde artículos de cocina y electrodomésticos hasta tecnología, belleza y peinado. Precios en bolivianos y entrega rápida en Villa Tunari, Shinahota, Chimoré y todo el Chapare.</p>
      <div class="hero-cta">
        <button class="btn btn-primary" onclick="document.getElementById('catalogo').scrollIntoView({behavior:'smooth'})">Ver catálogo</button>
        <a class="btn btn-ghost" href="https://wa.me/59172774839" target="_blank" rel="noopener">Consultar por WhatsApp</a>
      </div>
    </div>
    <div class="hero-card">
      <span class="pill">Oferta de la semana</span>
      <h3 style="margin-top:12px">Ollas, licuadoras y más con hasta 25% off</h3>
      <p style="opacity:.9;margin:6px 0 0">Pago contra entrega o QR. Sin complicaciones.</p>
      <div class="hero-stats">
        <div><b>25+</b><span>Productos</span></div>
        <div><b>24h</b><span>Entrega local</span></div>
        <div><b>100%</b><span>Garantía</span></div>
      </div>
    </div>
  </div>
</section>

<main class="wrap" id="catalogo">
  <div class="cats" id="cats"></div>
  <div class="section-head">
    <h2>Catálogo</h2>
    <span id="count"></span>
  </div>
  <div class="grid" id="grid"></div>
</main>

<button class="cartbar" id="cartbar" onclick="openCart()">
  <span>🛒 <b id="cartbarCount">0</b> productos</span>
  <span id="cartbarTotal">Bs 0</span>
  <span class="cta">Ver carrito →</span>
</button>

<div class="overlay" id="overlay" onclick="closeCart()"></div>
<aside class="drawer" id="drawer">
  <div class="drawer-head">
    <h3>Tu carrito 🛒</h3>
    <button class="close" onclick="closeCart()">✕</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="drawer-foot">
    <div class="total-row"><span>Total</span><span id="total">Bs 0</span></div>
    <a class="wa" id="waBtn" href="#" target="_blank" rel="noopener">Pedir por WhatsApp</a>
  </div>
</aside>

<footer>
  <div class="wrap foot-grid">
    <div>
      <h4>🌴 TropiMarket</h4>
      <p>Tu tienda de productos para el hogar en Ivirgarzama y todo el trópico de Cochabamba. Calidad, buen precio y entrega rápida.</p>
    </div>
    <div>
      <h4>Categorías</h4>
      <p>Cocina · Electrodomésticos<br>Tecnología · Belleza<br>Hogar · Herramientas</p>
    </div>
    <div>
      <h4>Contacto</h4>
      <p>📍 Av. Principal, Ivirgarzama<br>📱 WhatsApp: 727 748 39<br>🕒 Lun–Sáb 8:00–20:00</p>
    </div>
  </div>
</footer>

<script>
const WHATSAPP="59172774839";
const products=[
  {id:1,cat:"Cocina",em:"🍳",name:"Sartén antiadherente 28cm",desc:"Base de aluminio, mango ergonómico.",price:145,tag:"Oferta"},
  {id:2,cat:"Cocina",em:"🥘",name:"Juego de ollas 7 piezas",desc:"Acero inoxidable con tapa de vidrio.",price:520,tag:"-25%"},
  {id:3,cat:"Cocina",em:"🔪",name:"Set de cuchillos 6 piezas",desc:"Con soporte de madera incluido.",price:180},
  {id:4,cat:"Cocina",em:"🍽️",name:"Vajilla 24 piezas",desc:"Porcelana para 6 personas.",price:260},
  {id:5,cat:"Cocina",em:"☕",name:"Cafetera italiana 6 tazas",desc:"Aluminio, ideal para café espresso.",price:95},
  {id:6,cat:"Electrodomésticos",em:"🌀",name:"Licuadora 1.5L 600W",desc:"3 velocidades y vaso de vidrio.",price:280,tag:"Top"},
  {id:7,cat:"Electrodomésticos",em:"📺",name:'Televisor Smart 43" 4K',desc:"Netflix, YouTube y WiFi integrado.",price:2450,tag:"Nuevo"},
  {id:8,cat:"Electrodomésticos",em:"❄️",name:"Ventilador de pie 16''",desc:"Ideal para el calor del trópico.",price:210},
  {id:9,cat:"Electrodomésticos",em:"🧺",name:"Lavadora semiautomática 9kg",desc:"Doble tina, bajo consumo de agua.",price:1650},
  {id:10,cat:"Electrodomésticos",em:"🔥",name:"Cocina a gas 4 hornallas",desc:"Con horno y encendido eléctrico.",price:1350},
  {id:11,cat:"Electrodomésticos",em:"🍞",name:"Tostadora 2 panes",desc:"7 niveles de tostado.",price:120},
  {id:12,cat:"Electrodomésticos",em:"♨️",name:"Arrocera 1.8L",desc:"Cocción automática y mantiene caliente.",price:175},
  {id:13,cat:"Tecnología",em:"📱",name:"Smartphone 128GB",desc:"Pantalla 6.5'', cámara 50MP.",price:1890,tag:"Top"},
  {id:14,cat:"Tecnología",em:"🎧",name:"Audífonos Bluetooth",desc:"Inalámbricos con estuche de carga.",price:160},
  {id:15,cat:"Tecnología",em:"🔊",name:"Parlante portátil 20W",desc:"Bluetooth, resistente al agua.",price:230,tag:"Oferta"},
  {id:16,cat:"Tecnología",em:"💻",name:"Laptop 15.6'' 8GB RAM",desc:"SSD 256GB, ideal estudio y trabajo.",price:4200},
  {id:17,cat:"Belleza",em:"💇",name:"Plancha de cabello cerámica",desc:"Calentamiento rápido, temperatura ajustable.",price:140,tag:"-20%"},
  {id:18,cat:"Belleza",em:"💨",name:"Secador de cabello 2000W",desc:"2 velocidades y aire frío.",price:150},
  {id:19,cat:"Belleza",em:"✂️",name:"Máquina de cortar cabello",desc:"Recargable, con 4 peines guía.",price:190,tag:"Top"},
  {id:20,cat:"Belleza",em:"🌀",name:"Rizador de cabello",desc:"Barril cerámico anti-frizz.",price:130},
  {id:21,cat:"Hogar",em:"🛋️",name:"Juego de sábanas 2 plazas",desc:"Algodón suave, incluye fundas.",price:220},
  {id:22,cat:"Hogar",em:"🪑",name:"Set de 4 sillas plásticas",desc:"Resistentes, apilables para patio.",price:340},
  {id:23,cat:"Hogar",em:"💡",name:"Foco LED inteligente RGB",desc:"Control por app, 16 millones de colores.",price:85},
  {id:24,cat:"Herramientas",em:"🔧",name:"Caja de herramientas 129 pzas",desc:"Completa para el hogar.",price:390,tag:"Nuevo"},
  {id:25,cat:"Herramientas",em:"🪚",name:"Taladro inalámbrico 20V",desc:"Con 2 baterías y maletín.",price:520},
];

const cart={};
const IMG={1:'data:image/jpeg;base64,',2:'data:image/jpeg;base64,',3:'data:image/jpeg;base64,',4:'data:image/jpeg;base64,',5:'data:image/jpeg;base64,',6:'data:image/jpeg;base64,',7:'data:image/jpeg;base64,',8:'data:image/jpeg;base64,',9:'data:image/jpeg;base64,',10:'data:image/jpeg;base64,',11:'data:image/jpeg;base64,',12:'data:image/jpeg;base64,',13:'data:image/jpeg;base64,',14:'data:image/jpeg;base64,',15:'data:image/jpeg;base64,',16:'data:image/jpeg;base64,',17:'data:image/jpeg;base64,',18:'data:image/jpeg;base64,',19:'data:image/jpeg;base64,',20:'data:image/jpeg;base64,',21:'data:image/jpeg;base64,',22:'data:image/jpeg;base64,',23:'data:image/jpeg;base64,',24:'data:image/jpeg;base64,',25:'data:image/jpeg;base64,'};
let activeCat="Todos";
const cats=["Todos",...new Set(products.map(p=>p.cat))];

function renderCats(){
  document.getElementById('cats').innerHTML=cats.map(c=>
    `<button class="chip ${c===activeCat?'active':''}" onclick="setCat('${c}')">${c}</button>`).join('');
}
function setCat(c){activeCat=c;renderCats();render();}

function fmt(n){return "Bs "+n.toLocaleString('es-BO');}

function syncSearch(v){document.getElementById('search').value=v;render();}

function render(){
  const q=(document.getElementById('search').value||'').toLowerCase();
  const list=products.filter(p=>(activeCat==="Todos"||p.cat===activeCat)
    &&(p.name.toLowerCase().includes(q)||p.cat.toLowerCase().includes(q)||p.desc.toLowerCase().includes(q)));
  document.getElementById('count').textContent=list.length+" productos";
  document.getElementById('grid').innerHTML=list.map(p=>`
    <article class="card">
      <div class="thumb">
        ${p.tag?`<span class="tag">${p.tag}</span>`:''}
        <img src="${IMG[p.id]}" alt="${p.name}" loading="lazy"
          onerror="this.style.display='none';this.parentNode.insertAdjacentHTML('beforeend','<div style=\\'display:grid;place-items:center;height:100%;font-size:3rem\\'>${p.em}</div>')">
      </div>
      <div class="card-body">
        <span class="cat-label">${p.cat}</span>
        <h3>${p.name}</h3>
        <p class="desc">${p.desc}</p>
        <div class="price-row">
          <span class="price">${fmt(p.price)}</span>
          <button class="add" onclick="addToCart(${p.id})">+ Agregar</button>
        </div>
      </div>
    </article>`).join('') || `<p class="empty" style="grid-column:1/-1">No se encontraron productos 🔍</p>`;
}

function addToCart(id){cart[id]=(cart[id]||0)+1;updateCart();bump();}
function changeQty(id,d){cart[id]=(cart[id]||0)+d;if(cart[id]<=0)delete cart[id];updateCart();}

function updateCart(){
  const ids=Object.keys(cart);
  const count=ids.reduce((s,i)=>s+cart[i],0);
  const total=ids.reduce((s,i)=>s+cart[i]*products.find(p=>p.id==i).price,0);
  document.getElementById('badge').textContent=count;
  document.getElementById('total').textContent=fmt(total);
  document.getElementById('cartbarCount').textContent=count;
  document.getElementById('cartbarTotal').textContent=fmt(total);
  document.getElementById('cartbar').classList.toggle('show',count>0);
  const box=document.getElementById('cartItems');
  if(!ids.length){box.innerHTML=`<div class="empty">Tu carrito está vacío 🛒<br><small>Agrega productos del catálogo</small></div>`;}
  else{box.innerHTML=ids.map(i=>{const p=products.find(x=>x.id==i);return`
    <div class="ci"><div class="em">${p.em}</div>
      <div class="ci-info"><b>${p.name}</b><span>${fmt(p.price)}</span></div>
      <div class="qty"><button onclick="changeQty(${i},-1)">−</button><b>${cart[i]}</b>
        <button onclick="changeQty(${i},1)">+</button></div></div>`}).join('');}
  // WhatsApp order text
  let msg="Hola! Quiero pedir:%0A";
  ids.forEach(i=>{const p=products.find(x=>x.id==i);msg+=`• ${cart[i]}x ${p.name} — ${fmt(p.price*cart[i])}%0A`});
  msg+=`%0ATotal: ${fmt(total)}`;
  document.getElementById('waBtn').href=`https://wa.me/${WHATSAPP}?text=${msg}`;
}
function bump(){const b=document.getElementById('badge');b.animate([{transform:'scale(1.4)'},{transform:'scale(1)'}],{duration:250});}
function openCart(){document.getElementById('drawer').classList.add('open');document.getElementById('overlay').classList.add('open');}
function closeCart(){document.getElementById('drawer').classList.remove('open');document.getElementById('overlay').classList.remove('open');}

function toggleTheme(){
  const r=document.documentElement;
  const dark=r.getAttribute('data-theme')==='dark'|| (!r.getAttribute('data-theme')&&matchMedia('(prefers-color-scheme:dark)').matches);
  r.setAttribute('data-theme',dark?'light':'dark');
  document.getElementById('themeBtn').textContent=dark?'🌙':'☀️';
}

renderCats();render();updateCart();
</script>

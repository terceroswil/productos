# ══════════════════════════════════════════════════════════════════
#  Configuracion de Los Caseritos
#  Copia este archivo como  .env  y completa los valores.
#  El archivo .env NUNCA se sube a internet.
# ══════════════════════════════════════════════════════════════════

# --- Panel con clave -------------------------------------------------
# Genera estas tres lineas con:
#     node herramientas/clave.cjs "tu clave" tu-usuario
# Si las dejas vacias, el panel se abre sin clave pero SOLO desde
# esta computadora (modo local, como venia funcionando).

PANEL_USUARIO=
PANEL_CLAVE_HASH=
SESION_SECRETO=

# --- Servidor --------------------------------------------------------
# MODO=produccion  hace que escuche hacia internet y exige HTTPS en la
# cookie. En tu computadora dejalo vacio.
MODO=
PORT=4100

# Carpeta donde se guardan catalogo, respaldos y estadisticas.
# En un servidor con disco aparte, apunta ahi para que los datos
# sobrevivan a los reinicios. Ej: /var/data
DATOS_DIR=

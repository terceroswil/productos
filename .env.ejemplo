# ══════════════════════════════════════════════════════════════════
#  Configuracion de Los Caseritos
#  Copia este archivo como  .env  y completa los valores.
#  El archivo .env NUNCA se sube a internet.
# ══════════════════════════════════════════════════════════════════

# --- Panel con clave -------------------------------------------------
# Genera estas tres lineas con:
#     node herramientas/clave.cjs "tu clave" tu-usuario
# Si las dejas vacias, el panel se abre sin clave pero SOLO desde
# esta computadora (modo local, como venia funcionando).

PANEL_USUARIO=
PANEL_CLAVE_HASH=
SESION_SECRETO=

# --- Servidor --------------------------------------------------------
# MODO=produccion  hace que escuche hacia internet y exige HTTPS en la
# cookie. En tu computadora dejalo vacio.
MODO=
PORT=3001

# Carpeta donde se guardan catalogo, respaldos y estadisticas.
# En un servidor con disco aparte, apunta ahi para que los datos
# sobrevivan a los reinicios. Ej: /var/data
DATOS_DIR=

# --- Inventario (inventario/servidor.js) -----------------------------
# El productos.json que EDITA la tienda web. De ahi salen los productos y
# los precios, y al lado se deja stock-inventario.json para que la web
# muestre el stock de verdad.
# OJO: si el inventario vive en otra carpeta que la tienda, esto tiene
# que apuntar a la carpeta de la TIENDA. Vacio = el productos.json de
# esta misma carpeta.
#     Ej: INV_CATALOGO=D:\CLAUDE-IA\proyectos\productos\productos.json
INV_CATALOGO=

# La tienda cuyo stock se muestra en la web: la que despacha los pedidos
# online. Va el nombre tal cual figura en el inventario. Vacio = la primera.
INV_TIENDA_WEB=

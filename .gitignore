# ── Nunca a internet ──────────────────────────────────────────────
# Adentro van la clave del panel y SESION_SECRETO: con ese secreto
# cualquiera se fabrica una sesion valida sin saber la clave.
.env

# ── Se genera solo ────────────────────────────────────────────────
# publicar/ lo rearma  node herramientas/publicar.cjs  cuando haga falta.
publicar/

# ── Datos del comerciante, no del codigo ──────────────────────────
# Respaldos automaticos del catalogo y estadisticas de visitas.
data/respaldos/
data/eventos.jsonl
# hora del ultimo "Salir": corta las sesiones abiertas y es de esta instalacion
data/sesiones-cortadas
# Base de datos del inventario: ventas, stock y usuarios de las tiendas
data/inventario/

# El stock que deja el sistema de inventario para que la tienda lo muestre.
# Se reescribe con cada venta del mostrador: es un dato, no codigo.
stock-inventario.json
stock-inventario.json.tmp

# ── Ruido del sistema ─────────────────────────────────────────────
node_modules/
Thumbs.db
desktop.ini
.DS_Store
*.log

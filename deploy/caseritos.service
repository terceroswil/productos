# Servicio de Los Caseritos. Va en /etc/systemd/system/caseritos.service
#
# OJO: esto es para un VPS. No es lo que corre hoy en la computadora, que
# sale por un tunel de Cloudflare. Ver COMO-ESTA-PUBLICADA.md.

[Unit]
Description=Los Caseritos (tienda web)
After=network.target

[Service]
Type=simple
User=caseritos
Group=caseritos
WorkingDirectory=/opt/caseritos
EnvironmentFile=/etc/caseritos.env
ExecStart=/usr/bin/node serve.js
Restart=always
RestartSec=3

# --- Endurecimiento basico ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Solo puede escribir en la carpeta de datos: el catalogo y las fotos que
# sube el comerciante viven ahi, asi actualizar el codigo no los borra.
ReadWritePaths=/var/lib/caseritos

[Install]
WantedBy=multi-user.target

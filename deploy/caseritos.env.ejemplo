# Va en /etc/caseritos.env  (chmod 600, solo root lo lee)
# Genera las tres primeras lineas con:
#     node herramientas/clave.cjs "la clave del comerciante" don-julio

PANEL_USUARIO=don-julio
PANEL_CLAVE_HASH=
SESION_SECRETO=

MODO=produccion
PORT=4100

# Los datos van FUERA de /opt/caseritos: asi actualizar el codigo
# no borra los productos ni las fotos.
DATOS_DIR=/var/lib/caseritos

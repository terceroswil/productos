# Va en /etc/caseritos.env  (chmod 600, solo root lo lee)
# Genera las tres primeras lineas con:
#     node herramientas/clave.cjs "la clave del comerciante" don-julio

PANEL_USUARIO=don-julio
PANEL_CLAVE_HASH=
SESION_SECRETO=

MODO=produccion
PORT=3001

# Los datos van FUERA de /opt/caseritos: asi actualizar el codigo
# no borra los productos ni las fotos.
DATOS_DIR=/var/lib/caseritos

# --- Solo si la tienda cuelga de una subcarpeta -----------------------
# Con  motoivir.com/caseritos  va  BASE_PATH=/caseritos : sin eso, cuando
# el panel manda a la pantalla de entrada el comerciante termina en
# motoivir.com/entrar.html, que no existe.
#
# Con DOMINIO PROPIO (caseritos.com) esta linea va VACIA o borrada. Si
# queda puesta, la entrada redirige a caseritos.com/caseritos/entrar.html
# y da 404. Es el error mas facil de cometer al mudarse.
BASE_PATH=

# Va en /etc/caseritos.env  (chmod 600, solo root lo lee)
#
# OJO: esto es para un VPS. No es lo que corre hoy en la computadora, que
# usa el .env del proyecto. Ver COMO-ESTA-PUBLICADA.md.
#
# Genera las tres primeras lineas con:
#     node herramientas/clave.cjs "la clave del comerciante" caserito

PANEL_USUARIO=caserito
PANEL_CLAVE_HASH=
SESION_SECRETO=

MODO=produccion
PORT=3001

# Los datos van FUERA de /opt/caseritos: asi actualizar el codigo
# no borra los productos ni las fotos.
DATOS_DIR=/var/lib/caseritos

# BASE_PATH solo sirve si la tienda cuelga de una subcarpeta de otro
# dominio. Con dominio propio va VACIO. Si queda puesto, la pantalla de
# entrada del panel redirige a loscaseritos.com/eso/entrar.html y da 404.
BASE_PATH=
